# RAG MCP 环境配置模板
# 复制为 `.env` 并按需修改。`.env` 已加入 .gitignore，不会提交到仓库。
#
# 本地开发默认值（与 docker-compose.yml 一致）：无需设置即可启动，
# config.py 内置 localhost 默认值。仅在连接远程/其他环境时覆盖下列变量。

# PostgreSQL（async 引擎，服务运行时使用）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_mcp

# PostgreSQL（sync 引擎，Alembic 迁移使用）
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_mcp

# Qdrant 向量库
QDRANT_URL=http://localhost:6333

# 管理面 REST API 端口（默认 8000）
MANAGEMENT_PORT=8000

# MCP Streamable HTTP 端口（默认 8080，客户端手动配置此 URL）
MCP_PORT=8080

# 上传原始文件的本地数据根目录
DATA_ROOT=./data/uploads

# Embedding 模型（本地 CPU 默认 BAAI/bge-m3，Dense 1024 维）
EMBEDDING_MODEL=BAAI/bge-m3
