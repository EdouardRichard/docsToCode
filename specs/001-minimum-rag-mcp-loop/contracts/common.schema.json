{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-rag-mcp.local/schemas/001/common.schema.json",
  "title": "Common Schema Definitions",
  "description": "跨MCP Tool和管理API共享的类型定义（蓝图 §22）。其他schema通过$ref引用本文件中的definitions。",
  "type": "object",
  "definitions": {
    "KnowledgeScopeId": {
      "type": "string",
      "description": "知识域稳定标识（Snowflake ID字符串形式）",
      "pattern": "^[0-9]+$",
      "minLength": 1
    },
    "KnowledgeScopeType": {
      "type": "string",
      "enum": ["project", "public"],
      "description": "知识域类型"
    },
    "ProjectRef": {
      "type": "string",
      "description": "项目引用，可以是稳定ID、别名或仓库路径",
      "minLength": 1
    },
    "EvidenceId": {
      "type": "string",
      "description": "证据唯一标识，由系统生成，可用于get_evidence展开",
      "minLength": 1
    },
    "SourceVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "知识源版本号（单调递增整数）"
    },
    "SourcePosition": {
      "type": "string",
      "description": "来源位置路径。Markdown为章节路径（如'## 安装 > ### 配置'），Java为全限定符号路径（如'com.example.Service#methodName'）"
    },
    "CompletionStatus": {
      "type": "string",
      "enum": ["complete", "partial", "no_evidence", "failed"],
      "description": "检索完成状态（蓝图 §14 四态）"
    },
    "RelevanceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "相关性分数"
    },
    "EvidenceItem": {
      "type": "object",
      "description": "单条证据的结构化表示",
      "properties": {
        "evidence_id": { "$ref": "#/definitions/EvidenceId" },
        "content_excerpt": {
          "type": "string",
          "description": "精简的证据摘录，不超过500字符",
          "maxLength": 500
        },
        "source_version": { "$ref": "#/definitions/SourceVersion" },
        "source_position": { "$ref": "#/definitions/SourcePosition" },
        "knowledge_scope_id": { "$ref": "#/definitions/KnowledgeScopeId" },
        "knowledge_scope_type": { "$ref": "#/definitions/KnowledgeScopeType" },
        "relevance_score": { "$ref": "#/definitions/RelevanceScore" }
      },
      "required": ["evidence_id", "content_excerpt", "source_version", "source_position", "knowledge_scope_id", "knowledge_scope_type", "relevance_score"],
      "additionalProperties": false
    },
    "ErrorObject": {
      "type": "object",
      "description": "标准化错误对象",
      "properties": {
        "code": {
          "type": "string",
          "description": "机器可读的错误码"
        },
        "message": {
          "type": "string",
          "description": "人类可读的错误描述"
        }
      },
      "required": ["code", "message"],
      "additionalProperties": true
    },
    "RequestId": {
      "type": "string",
      "description": "请求唯一标识，用于问题回溯和日志关联",
      "minLength": 1
    }
  }
}
